# Credenciales de MySQL usadas por docker-compose.yml (servicio "db")
# Copiar a ".env" en la raíz del proyecto y completar antes de "docker compose up".
# Estos MISMOS valores de DB_NAME/DB_USER/DB_PASSWORD deben coincidir con los
# que use el backend (docker-compose ya se encarga de pasárselos).
DB_NAME=alumco
DB_USER=alumco_app
DB_PASSWORD=cambiar_por_una_clave_fuerte
DB_ROOT_PASSWORD=cambiar_por_otra_clave_fuerte
