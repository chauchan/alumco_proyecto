# Variables de entorno del backend para producción en AWS (EC2, todo-en-uno).
# Copiar a "server/.env" en la instancia EC2 y completar.
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME/PORT los sobreescribe
# docker-compose.yml automáticamente — no hace falta tocarlos acá.

NODE_ENV=production

# URL pública por la que se accede al sitio (IP elástica o dominio).
# Como Nginx sirve el frontend y hace de proxy de /api en el mismo origen,
# esto es solo para el chequeo de arranque; no genera problemas de CORS.
CLIENT_URL=http://TU_IP_O_DOMINIO

# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=ALUMCO

# --- IA ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Google OAuth (actualizar redirect URI al nuevo dominio/IP en Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://TU_IP_O_DOMINIO/api/google/callback

# --- AWS S3 ---
# Dejar AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY VACÍOS en EC2 dentro de un
# AWS Academy Learner Lab: si la instancia tiene el LabInstanceProfile
# asociado, el SDK toma credenciales automáticamente del instance profile
# (se renuevan solas, sin este problema de expiración de las temporales del lab).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET_NAME=
AWS_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
