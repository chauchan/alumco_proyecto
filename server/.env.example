PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=alumco
# DEBE tener al menos 32 caracteres aleatorios. Generá con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Email (Resend — HTTPS, no SMTP)
# Crear cuenta gratis en https://resend.com y generar API key en https://resend.com/api-keys
RESEND_API_KEY=
# Sin dominio verificado, dejar 'onboarding@resend.dev' (solo entrega al email de tu cuenta Resend).
# Con dominio verificado en Resend, usar algo como 'noreply@tudominio.cl'.
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=ALUMCO
